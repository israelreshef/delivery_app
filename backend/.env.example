# TZIR Delivery - Backend Environment Template
# Copy this file to .env and fill in the actual values.

# --- Core Server Settings ---
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=yoursupersecretkey  # Used for session signing and general security

# --- Database Configuration ---
# Example: postgresql://user:password@localhost:5432/tzir_db
DATABASE_URL=sqlite:///dev.db

# --- Security & Encryption ---
# AES-256 Key for at-rest encryption (must be exactly 32 bytes/characters)
# Use a secure random generator to create this.
ENCRYPTION_KEY=12345678901234567890123456789012

# JWT Configuration
JWT_SECRET=jwt-secret-key-change-me
JWT_ACCESS_TOKEN_EXPIRES=3600  # Token expiry in seconds

# --- WAF (in-process, S3) ---
# Safety net: enables the in-app WAF layer. The backend auto-enables it with
# FLASK_ENV=production, but set explicitly to 'true' everywhere it is deployed
# (docker-compose.prod.yml, AWS App Runner env, etc.) so it stays on even if
# FLASK_ENV is misconfigured.
SECURITY_WAF_ENABLED=true

# --- Monitoring & Auditing ---
AUDIT_LOG_FILE=logs/audit.json
ERROR_LOG_FILE=logs/error.log

# --- Third-Party Integrations ---
# Google Maps API (for routing and geocoding)
GOOGLE_MAPS_API_KEY=your-api-key-here

# SmartBee (Payments)
SMARTBEE_API_KEY=your-smartbee-key
SMART_BEE_ACCOUNT_ID=your-account-id

# Google Calendar (for dispatching)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

# WhatsApp API (Twilio or similar)
WHATSAPP_API_SID=your-sid
WHATSAPP_API_TOKEN=your-token
WHATSAPP_FROM_NUMBER=whatsapp:+1234567890
