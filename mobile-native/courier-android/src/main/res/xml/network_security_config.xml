<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Development/local: allow plain HTTP to the dev hosts (emulator alias + LAN IP) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.33.18</domain>
        <domain includeSubdomains="true">192.168.33.13</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
