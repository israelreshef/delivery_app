<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Deny all cleartext traffic globally -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <!-- Reject User-Installed CAs (Apple Tier requirement) -->
        </trust-anchors>
    </base-config>

    <domain-config>
        <domain includeSubdomains="true">api.tzir-delivery.co.il</domain>
        <pin-set expiration="2027-03-08">
            <!-- Primary Pin (Leaf) -->
            <pin digest="SHA-256">Base64EncodedPin1=</pin>
            <!-- Backup Pin 1 (Intermediate) -->
            <pin digest="SHA-256">Base64EncodedPin2=</pin>
            <!-- Backup Pin 2 (Root) -->
            <pin digest="SHA-256">Base64EncodedPin3=</pin>
        </pin-set>
        <!-- Enforce Certificate Transparency -->
        <certificate-transparency enabled="true" />
    </domain-config>
</network-security-config>
